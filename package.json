{
  "name": "zevyron",
  "version": "3.0.0-beta.15",
  "description": "Zevyron - Advanced System Performance | Developed by PrimeTools Lab | Stable | Free and Open Source",
  "main": "./out/main/index.js",
  "author": "PrimeTools Lab",
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "start": "electron-vite preview",
    "dev": "electron-vite dev -w",
    "build": "node build.js",
    "build:registry": "pnpm run build -- --registry",
    "build:electron": "pnpm run build:vite && electron-builder --config electron-builder.config.cjs",
    "build:vite": "electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "pnpm run build:vite && electron-builder --config electron-builder.config.cjs --dir",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "test": "vitest run  --reporter=verbose",
    "test:watch": "vitest",
    "test:smoke": "node scripts/smoke-test.mjs",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "test:all": "pnpm run typecheck && pnpm run lint && pnpm run test",
    "release:win": "pnpm run build:vite && electron-builder --config electron-builder.config.cjs --win --publish never",
    "release:github": "pnpm run build:vite && electron-builder --config electron-builder.config.cjs --win --publish always",
    "github:configure": "node scripts/configure-github.mjs",
    "audit:release": "node scripts/release-audit.mjs",
    "check:version-sync": "node scripts/version-sync-check.mjs",
    "audit:stability": "node scripts/stability-audit.mjs",
    "audit:i18n": "node scripts/i18n-audit.mjs",
    "verify:stable-readiness": "pnpm run typecheck && pnpm run test && pnpm run audit:release && pnpm run audit:stability && pnpm run audit:i18n"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "discord-rpc-new": "^1.4.1",
    "electron-log": "^5.4.4",
    "electron-store": "8.1.0",
    "electron-updater": "^6.8.9",
    "systeminformation": "^5.32.0"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config": "^2.1.0",
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@lucide/lab": "^0.1.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "clsx": "^2.1.1",
    "electron": "^43.1.1",
    "electron-builder": "26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "lucide-react": "^1.25.0",
    "postcss": "^8.5.19",
    "prettier": "^3.9.5",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.1",
    "react-toastify": "^11.1.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.10",
    "zustand": "^5.0.14"
  },
  "build": {
    "electronLanguages": [
      "pt-BR",
      "en-US",
      "es"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": ".",
        "filter": [
          "*.exe",
          "*.ico",
          "*.nip",
          "*.pow"
        ]
      },
      {
        "from": "LICENSE",
        "to": "legal/LICENSE-GPL-3.0.txt"
      },
      {
        "from": "NOTICE.md",
        "to": "legal/NOTICE.md"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "legal/THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "SOURCE_CODE.md",
        "to": "legal/SOURCE_CODE.md"
      }
    ],
    "appId": "com.zevyron.app",
    "productName": "Zevyron",
    "directories": {
      "buildResources": "build"
    },
    "files": [
      "!**/.vscode/*",
      "!src/*",
      "!dist-old",
      "!dist-2",
      "!electron-builde.yml",
      "!images/*",
      "!electron.vite.config.{js,ts,mjs,cjs}",
      "!{.eslintignore,.eslintrc.cjs,.prettierignore,.prettierrc.yaml,dev-app-update.yml,CHANGELOG.md,README.md}",
      "!{.env,.env.*,.npmrc,pnpm-lock.yaml,yarn.lock}",
      "!docs/**",
      "!eslint.config.mjs",
      "!get.ps1",
      "!license",
      "!trusted-dependencies-scripts.json",
      "!postcss.config.js",
      "!tsconfig.json",
      "!tsconfig.node.json",
      "!tsconfig.web.json",
      "!build.js",
      "!jsconfig.json",
      "!LICENSE",
      "!scripts/**",
      "!bucket/**",
      "!pnpm-workspace.yaml",
      "!vitest.config.ts",
      "!resources/**",
      "!chocolatey/**"
    ],
    "win": {
      "executableName": "Zevyron",
      "requestedExecutionLevel": "requireAdministrator",
      "icon": "resources/zevyron.ico",
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "artifactName": "${productName}-${version}-Setup.${ext}",
      "shortcutName": "${productName}",
      "uninstallDisplayName": "${productName}",
      "createDesktopShortcut": "always",
      "oneClick": false,
      "installerSidebar": "build/zevyron-installer-sidebar.bmp",
      "uninstallerSidebar": "build/zevyron-installer-sidebar.bmp",
      "installerHeader": "build/zevyron-installer-header.bmp",
      "allowToChangeInstallationDirectory": true,
      "multiLanguageInstaller": true,
      "displayLanguageSelector": true,
      "installerLanguages": [
        "pt_BR",
        "en_US",
        "es_ES"
      ],
      "installerIcon": "build/installerIcon.ico",
      "uninstallerIcon": "build/installerIcon.ico",
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "license": "build/license.txt"
    },
    "npmRebuild": false,
    "generateUpdatesFilesForAllChannels": true
  },
  "packageManager": "pnpm@10.29.3"
}
